# Private local mode: choose a random secret of at least 32 characters.
QUANTFORGE_API_TOKEN=
QUANTFORGE_DATA_DIR=.quantforge
# Optional anonymous synthetic demo. No shared secret is sent to visitors.
QUANTFORGE_PUBLIC_DEMO=false
# Set true behind production HTTPS; leave false for local HTTP.
QUANTFORGE_COOKIE_SECURE=false
QUANTFORGE_HOST=127.0.0.1
# Cloud platforms normally supply PORT. Run exactly one instance/worker.
PORT=8000
